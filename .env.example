# --- Telegram ---
# Получить у @BotFather. Privacy mode оставить ВКЛЮЧЁННЫМ (это дефолт):
# бот и так будет видеть упоминания и реплаи, а прав администратора не потребуется.
TELEGRAM_BOT_TOKEN=

# Любая длинная случайная строка. Ею подписываются запросы Telegram к вебхуку —
# без неё эндпоинт на Vercel мог бы дёргать кто угодно, скармливая боту фальшивки.
# Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=AI Social Bot
OPENROUTER_APP_URL=https://github.com/deusonedos/ai-social-bot

# --- Поиск в интернете (необязательно) ---
# Без ключа бот работает как раньше, только честно предупреждает, что не знает
# актуального. С ключом — ищет свежую информацию по вопросам о текущих событиях.
# Бесплатный тариф Tavily: 1000 запросов в месяц, карта не нужна.
# Ключ: https://app.tavily.com
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5

# --- База данных ---
# На Vercel нужен ИМЕННО Transaction pooler (порт 6543), а не Direct connection:
# прямое подключение к Supabase на бесплатном тарифе работает только по IPv6,
# а transaction-режим рассчитан на короткоживущие serverless-подключения.
# Берётся в дашборде Supabase: Connect -> Transaction pooler.
#
#   postgres://postgres.<ref>:<пароль>@aws-<регион>.pooler.supabase.com:6543/postgres
#
# Локально подойдёт и обычный Postgres.
DATABASE_URL=
DATABASE_SSL=true

# --- Квоты ---
# Бесплатный тир OpenRouter: 50 запросов в сутки без пополнения,
# 1000 после разового пополнения на $10. Лимит глобальный на аккаунт.
FREE_TIER_DAILY_QUOTA=1000

# Пускать ли трафик на дешёвые платные модели после исчерпания бесплатной квоты.
# ~$1-2 за 10 000 ответов. Пока false — при исчерпании бот вежливо отказывает.
PAID_OVERFLOW_ENABLED=false

# --- Лимиты и производительность ---
MAX_REQUESTS_PER_USER_PER_MIN=3
MAX_REQUESTS_PER_CHAT_PER_MIN=10

# Только для локального long polling.
WORKER_CONCURRENCY=4

# У OpenRouter лимит 20 запросов в минуту на аккаунт. Держим 18 — запас на служебные
# вызовы и на расхождение наших минутных окон с их учётом. В serverless это главная
# защита от 429: функции масштабируются автоматически и без общего счётчика
# двадцать одновременных сообщений мгновенно пробили бы лимит.
OPENROUTER_RPM_LIMIT=18
# Сколько ждать свободного слота, прежде чем ответить «слишком много запросов».
MODEL_SLOT_WAIT_MS=75000

# Задаётся автоматически на Vercel — вручную не нужен.
# SERVERLESS=true
# Защита cron-эндпоинта уборки на Vercel (openssl rand -hex 32).
CRON_SECRET=

CONTEXT_TOKEN_BUDGET=6000
CONTEXT_KEEP_RECENT_MESSAGES=20

MAX_IMAGES_PER_MESSAGE=3
MAX_IMAGE_BYTES=5242880

# Telegram user id администраторов через запятую.
ADMIN_USER_IDS=

LOG_LEVEL=info
NODE_ENV=development
