{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run typecheck",
  "outputDirectory": "public",
  "functions": {
    "api/telegram.ts": {
      "maxDuration": 300
    },
    "api/cleanup.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
